// docs.bklink.uk: the static export in ./out (npm run build), served as Cloudflare Workers static assets.
// No Worker script, no bindings, no secrets: deploy credentials come from the environment, never this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bklink-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "docs.bklink.uk", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
